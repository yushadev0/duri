{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duri",
  "version": "../package.json",
  "identifier": "app.duri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "A dynamic island for Windows",
    "copyright": "MIT License",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNDEyMTg1N0U3QTNFOTIKUldTU1BucCtoU0ZCY1FtZ0phMnY4K25aZ1UvdEZxSm1QWGJOTHJDZ0lSSkI5YnVmMFp6T2FlOGwK",
      "endpoints": [
        "https://github.com/yushadev0/duri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
