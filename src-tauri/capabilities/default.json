{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the island and settings windows",
  "windows": ["island", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "autostart:default",
    "notification:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
